# Required: independent random Auth.js secret (e.g. openssl rand -base64 32)
AUTH_SECRET=
# Required: PostgreSQL connection string; use server-side credentials only
POSTGRES_URL=
# Required outside Vercel OIDC: Vercel AI Gateway key
AI_GATEWAY_API_KEY=
# Required for existing image uploads: Vercel Blob token
BLOB_READ_WRITE_TOKEN=
# Required for distributed IP throttling and resumable streams
REDIS_URL=

# Required only for the server-side provider catalog; base64-encoded 32 random bytes
GRACE_ENCRYPTION_KEY=
# Only set temporarily in a trusted operator environment when using catalog add
# GRACE_PROVIDER_CREDENTIAL=

# Optional: enable the verified shared catalog after applying migrations
GRACE_CATALOG_ENABLED=0

# Optional: exact HTTPS hostnames permitted for generic OpenAI-compatible providers.
GRACE_CUSTOM_PROVIDER_HOSTS=

# Required for production registration: Cloudflare Turnstile site and secret keys.
NEXT_PUBLIC_GRACE_TURNSTILE_SITE_KEY=
GRACE_TURNSTILE_SECRET=
