# Independent random Auth.js secret (e.g. openssl rand -base64 32)
AUTH_SECRET=
# Public application origin, used to bind Turnstile challenges to this hostname
AUTH_URL=http://localhost:3000
# Server-only PostgreSQL connection using the application table owner / trusted role
POSTGRES_URL=
# Optional: AWS Supabase session-pooler hostname when POSTGRES_URL is a direct URL.
GRACE_SUPABASE_POOLER_HOST=

# Required to use the managed catalog. Generate a separate 32-byte base64 key;
# store it securely and back it up. It protects provider keys and admin TOTP seeds.
GRACE_ENCRYPTION_KEY=
GRACE_CATALOG_ENABLED=0
# Optional one-time first-owner setup secret (at least 32 random characters).
# Remove it from Vercel after creating the first owner; never commit its value.
GRACE_BOOTSTRAP_SECRET=
# Only set temporarily in a trusted operator process for the CLI catalog add command.
# GRACE_PROVIDER_CREDENTIAL=

# Optional exact HTTPS hostnames for generic OpenAI-compatible providers.
GRACE_CUSTOM_PROVIDER_HOSTS=

# Required for production registration, first-owner setup, and admin MFA.
NEXT_PUBLIC_GRACE_TURNSTILE_SITE_KEY=
GRACE_TURNSTILE_SECRET=

# Optional for the separately offered Vercel AI Gateway models when not using OIDC.
AI_GATEWAY_API_KEY=
